                "exec": [
                  "\r\npm.test(\"Status harus 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Produk berhasil diperbarui\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.status).to.eql(\"success\");\r\n    pm.expect(response.data.nama_produk).to.eql(\"Rak Serbaguna Besar\");\r\n    pm.expect(response.data.harga).to.eql(150000);\r\n    pm.expect(response.data.stok).to.eql(20);\r\n});\r\n"
                ]
              }
