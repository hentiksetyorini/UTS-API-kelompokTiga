        {
          "name": "S03 - Detail Produk Copy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status harus 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Detail produk berhasil ditampilkan\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response.status).to.eql(\"success\");\r\n    pm.expect(response.data.nama_produk).to.eql(\"Rak Serbaguna\");\r\n\r\n    pm.environment.set(\"produkId\", response.data.id);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/produk/1",
              "host": [
